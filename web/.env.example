# Copy to .env.local and fill in. Never commit real values.

# --- Holt API (server/) ---------------------------------------------------
# Called only from server code (route handlers, server components).
HOLT_API_URL=http://127.0.0.1:8000
HOLT_INTERNAL_KEY=change-me
# MOCK_API=1 serves realistic fixtures instead of calling HOLT_API_URL.
# Good for development and demos while the server is being built.
MOCK_API=1
# The server refuses to start with MOCK_API=1 when NODE_ENV=production,
# unless this is set (for a demo deployment).
# ALLOW_MOCK_IN_PROD=1

# --- Proxy ----------------------------------------------------------------
# Set to 1 only when the app is reachable solely through our proxy
# (Cloudflare tunnel): then cf-connecting-ip / X-Forwarded-For are trusted as
# the visitor's IP for rate limiting. Leave unset anywhere else.
# TRUST_PROXY_HEADERS=1

# --- Site -----------------------------------------------------------------
# The host shown in the "swap hub for holt" URL trick, badges and share links (production: githolt.com).
NEXT_PUBLIC_SITE_HOST=localhost:3000
# How many free AI reports a month the pricing page advertises (the server enforces the real limit).
NEXT_PUBLIC_FREE_AI_QUOTA=3

# --- Database (Auth.js users + sessions) ----------------------------------
# `docker compose up -d db` starts one on HOLT_DB_PORT.
HOLT_DB_PORT=5432
DATABASE_URL=postgres://holt:holt@127.0.0.1:5432/holt

# --- Auth.js --------------------------------------------------------------
# The public URL of this site. Required in production (OAuth callbacks).
AUTH_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=
# Leave both providers empty in development to get the dev-only sign-in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
