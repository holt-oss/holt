# Copy to server/.env (gitignored) and fill in. See README.md for each one.
DATABASE_URL=postgresql+asyncpg://holt:holt@127.0.0.1:20131/holt
HOLT_INTERNAL_KEY=
HOLT_SECRET_KEY=
HOLT_WEB_URL=http://127.0.0.1:3000   # production: https://githolt.com
GITHUB_TOKENS=
# Or read as the GitHub App (the maintainers' ops notes): all three, or none.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
HOLT_JOB_CONCURRENCY=2
# Keep each report's evidence (README.md, "Evidence snapshots"). Empty = off.
HOLT_EVIDENCE_DIR=
HOLT_EVIDENCE_KEEP_DAYS=0
HOLT_EVIDENCE_REUSE_HOURS=168
HOLT_SIGNUP_AI_CREDITS=0
HOLT_CLAIM_EVERY_DAYS=7
HOLT_ANON_RATE_PER_HOUR=10
HOLT_USER_RATE_PER_HOUR=60
# Pass checkout: off unless 1, with Razorpay (INR) or Dodo Payments (USD) set up.
HOLT_PAYMENTS_ENABLED=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Dodo Payments: the key, its mode (test or live), the webhook's whsec_ secret,
# and the one-time USD product (pdt_...) that sells each pass.
DODO_API_KEY=
DODO_ENV=test
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_PRO_1M=
DODO_PRODUCT_PRO_3M=
DODO_PRODUCT_PRO_12M=
